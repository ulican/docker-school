# Since the language and version are unknown, using a generic base image
FROM alpine:latest

# Create a non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Set the working directory
WORKDIR /app

# Copy the application files
COPY . .

# Change ownership to the non-root user
RUN chown -R appuser:appgroup /app

# Switch to the non-root user
USER appuser

# Placeholder for the command to run the application
CMD ["sh"]

# Expose a default port
EXPOSE 8080

# Healthcheck placeholder
HEALTHCHECK CMD echo 'Healthcheck not implemented'
